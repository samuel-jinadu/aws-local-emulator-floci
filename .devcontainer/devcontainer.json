{
	"name": "AWS Local - Floci",
	"image": "mcr.microsoft.com/devcontainers/base:trixie",
	"runArgs": [
		"--privileged",
		"--device",
		"/dev/kvm"
	],
	"features": {
		"ghcr.io/devcontainers/features/docker-in-docker:2": {
			"enableNonRootDocker": "true",
			"moby": "false"
		},
		"ghcr.io/devcontainers/features/aws-cli:1": {}
	}
}